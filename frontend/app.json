{
  "expo": {
    "name": "Fixora",
    "slug": "fixora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixora.app"
    },
    "android": {
      "package": "com.fixora.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E4D2B",
        "foregroundImage": "./assets/logo-square.png"
      }
    },
    "web": {
      "favicon": "./assets/logo-square.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "de64b9b1-3a5a-4b0f-8a6c-f0cf57f1901e"
      }
    }
  }
}
